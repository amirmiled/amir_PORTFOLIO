---
import { useTranslations } from "@/i18n/ui";

const t = useTranslations(Astro.currentLocale);
const bg = t.background;

// CEFR levels mapped to a 6-step scale (A1 … C2); native = full bar
const cefrSteps = ["A1", "A2", "B1", "B2", "C1", "C2"];
const levelWidth = (level: string) =>
  level ? ((cefrSteps.indexOf(level) + 1) / cefrSteps.length) * 100 : 100;
---

<section
  id="background"
  class="py-12 border-t border-[#ffffff10] text-[var(--white)]"
>
  <div class="max-w-5xl mx-auto">
    <h2 class="text-lg text-[var(--sec)] mb-2 shiny-sec">{bg.kicker}</h2>
    <h3 class="text-4xl md:text-5xl font-medium mb-10">{bg.title}</h3>

    <ol class="relative border-l border-[var(--white-icon-tr)] ml-2 space-y-10">
      {
        bg.education.map((item) => (
          <li class="pl-6 md:pl-10 relative">
            <span class="absolute -left-[7px] top-2 size-3 rounded-full bg-[var(--sec)] ring-4 ring-[var(--background)]" />
            <div class="flex flex-col md:flex-row md:items-baseline md:justify-between gap-1 md:gap-6">
              <h4 class="text-2xl font-semibold">{item.title}</h4>
              <span class="text-sm text-[var(--white-icon)] whitespace-nowrap">
                {item.period}
              </span>
            </div>
            <p class="text-[var(--sec)] font-medium mt-1">
              {item.link ? (
                <a
                  href={item.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="hover:underline"
                >
                  {item.org}
                </a>
              ) : (
                item.org
              )}
              <span class="text-[var(--white-icon)] font-normal">
                · {item.location}
              </span>
            </p>
            <ul class="mt-4 space-y-2 text-[var(--white-icon)]">
              {item.bullets.map((bullet) => (
                <li class="flex items-start">
                  <span class="pl-1">•</span>
                  <span class="pl-3">{bullet}</span>
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>

    <h4 class="text-3xl font-semibold mt-16 mb-6">{bg.skillsTitle}</h4>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      {
        bg.skills.map((group) => (
          <div class="bg-[#1414149c] border border-[var(--white-icon-tr)] rounded-2xl p-5">
            <p class="font-semibold mb-3">{group.category}</p>
            <ul class="flex flex-wrap gap-2">
              {group.items.map((skill) => (
                <li class="text-sm px-3 py-1 rounded-full border border-[var(--white-icon-tr)] text-[var(--white-icon)]">
                  {skill}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mt-16">
      <div>
        <h4 class="text-3xl font-semibold mb-6">{bg.languagesTitle}</h4>
        <ul class="space-y-5">
          {
            bg.languages.map((l) => (
              <li>
                <div class="flex justify-between items-baseline gap-4">
                  <span class="font-medium">{l.name}</span>
                  <span class="text-sm text-[var(--white-icon)] text-right">
                    {l.level && (
                      <span class="text-[var(--sec)] font-semibold mr-2">
                        {l.level}
                      </span>
                    )}
                    {l.note}
                  </span>
                </div>
                <div class="h-2 mt-2 rounded-full bg-[var(--white-icon-tr)] overflow-hidden">
                  <div
                    class="h-full rounded-full bg-[var(--sec)]"
                    style={`width: ${levelWidth(l.level)}%`}
                  />
                </div>
              </li>
            ))
          }
        </ul>
        <p class="text-xs text-[var(--white-icon)] mt-4">{bg.cefrNote}</p>
      </div>

      <div>
        <h4 class="text-3xl font-semibold mb-6">{bg.awardsTitle}</h4>
        <ul class="space-y-4">
          {
            bg.awards.map((award) => (
              <li class="bg-[#1414149c] border border-[var(--white-icon-tr)] rounded-2xl p-5">
                <div class="flex justify-between items-baseline gap-4">
                  <span class="font-semibold">{award.title}</span>
                  <span class="text-sm text-[var(--sec)]">{award.year}</span>
                </div>
                <p class="text-sm text-[var(--white-icon)] mt-1">
                  {award.detail}
                </p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
