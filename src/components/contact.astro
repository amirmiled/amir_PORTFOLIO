---
import EmailMenu from "./emailMenu.astro";
import { profile, useTranslations } from "@/i18n/ui";

const t = useTranslations(Astro.currentLocale);
---

<section id="contact" class="w-full py-12 border-t border-[#ffffff10]">
  <div class="max-w-5xl mx-auto">
    <h2 class="text-lg text-[var(--sec)] mb-2 shiny-sec">{t.contact.kicker}</h2>
    <h3 class="text-4xl md:text-5xl font-medium text-[var(--white)] mb-6">
      {t.contact.title}
    </h3>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <div class="text-[var(--white-icon)]">
        <p class="mb-6">{t.contact.intro}</p>
        <dl class="space-y-3">
          <div class="flex flex-wrap gap-x-2">
            <dt class="min-w-28">{t.contact.locationLabel}</dt>
            <dd class="text-[var(--white)]">{t.contact.location}</dd>
          </div>
          <div class="flex flex-wrap gap-x-2">
            <dt class="min-w-28">{t.contact.emailLabel}</dt>
            <dd>
              <EmailMenu class="text-[var(--white)] hover:text-[var(--sec)] transition-colors underline decoration-[var(--white-icon-tr)] underline-offset-4"
                >{profile.email}</EmailMenu
              >
            </dd>
          </div>
          <div class="flex flex-wrap gap-x-2">
            <dt class="min-w-28">{t.contact.phoneLabel}</dt>
            <dd>
              <a
                href={profile.phoneHref}
                class="text-[var(--white)] hover:text-[var(--sec)] transition-colors"
                >{profile.phone}</a
              >
            </dd>
          </div>
        </dl>
      </div>

      <div>
        <form
          id="contact-form"
          action="https://formspree.io/f/YOUR_FORM_ID_HERE"
          method="POST"
          data-error={t.contact.error}
          class="flex flex-col gap-4"
        >
          <input
            type="text"
            name="from_name"
            placeholder={t.contact.name}
            aria-label={t.contact.name}
            required
            class="px-4 py-2 bg-[#1414149c] text-[var(--white)] border border-[var(--white-icon-tr)] rounded-lg focus:outline-none focus:ring-2 focus:ring-[var(--sec)]"
          />
          <input
            type="email"
            name="reply_to"
            placeholder={t.contact.email}
            aria-label={t.contact.email}
            required
            class="px-4 py-2 bg-[#1414149c] text-[var(--white)] border border-[var(--white-icon-tr)] rounded-lg focus:outline-none focus:ring-2 focus:ring-[var(--sec)]"
          />
          <textarea
            name="message"
            placeholder={t.contact.message}
            aria-label={t.contact.message}
            rows="6"
            required
            class="px-4 py-2 bg-[#1414149c] text-[var(--white)] border border-[var(--white-icon-tr)] rounded-lg focus:outline-none focus:ring-2 focus:ring-[var(--sec)] resize-none"
          ></textarea>
          <button
            type="submit"
            class="px-4 py-2 bg-[var(--white-icon-tr)] text-[var(--white)] rounded-lg opacity-60 transition-opacity border border-[var(--white-icon-tr)] hover:opacity-100 hover:bg-[var(--white-icon-tr)]"
          >
            {t.contact.submit}
          </button>
        </form>
        <div
          id="form-message"
          class="hidden justify-center items-center mt-4 text-[var(--white)] text-lg"
        >
          {t.contact.success}
        </div>
      </div>
    </div>
  </div>
</section>

<script type="module" is:inline>
  const form = document.getElementById("contact-form");
  const formMessage = document.getElementById("form-message");

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    const formData = new FormData(form);

    try {
      const response = await fetch(form.action, {
        method: "POST",
        body: formData,
        headers: { Accept: "application/json" },
      });
      if (response.ok) {
        form.reset();
        form.style.display = "none";
        formMessage.classList.remove("hidden");
        formMessage.classList.add("flex");
      } else {
        const data = await response.json();
        console.error("Error response:", data);
        alert(form.dataset.error);
      }
    } catch (error) {
      console.error("Error:", error);
      alert(form.dataset.error);
    }
  });
</script>
